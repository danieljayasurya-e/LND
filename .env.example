# Copy this file to .env and fill in real values. .env is gitignored.

# EmailJS — Contact form (existing)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CUSTOMER_TMPL=
VITE_EMAILJS_ADMIN_TMPL=
VITE_EMAILJS_PUBLIC_KEY=
VITE_HF_API_TOKEN=

# Hackathon registration reuses the same two EmailJS templates above —
# no separate template IDs needed, the email body is generated in code.

# Server-only — used by /api serverless functions, NEVER prefix with VITE_
# (VITE_ vars get bundled into client JS; this one must not be)
DATABASE_URL=
